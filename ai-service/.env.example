# ==============================================================================
# Emergency Green Wave - Signal Action Agent AI Service
# Environment Configuration Template
# Copy this file to .env and configure appropriate values
# DO NOT COMMIT REAL SECRETS OR KEYS TO VERSION CONTROL
# ==============================================================================

# Google Gemini API Key (Required for Agent reasoning and LLM operations)
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Configuration
APP_NAME=Emergency Green Wave Signal Action AI Service
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Backend Integration (Existing ASP.NET Core SRMS API Simulation)
BACKEND_BASE_URL=http://localhost:5017/api

# Persistent Checkpoint Storage (SQLite)
# Optional override; defaults to checkpoints/signal_action_checkpoints.sqlite under ai-service/
CHECKPOINT_DB_PATH=checkpoints/signal_action_checkpoints.sqlite
