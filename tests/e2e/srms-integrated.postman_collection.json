{
  "info": {
    "name": "SRMS — Integrated System E2E",
    "description": "Cross-component workflow for the SE3090 system: health, hazard (mobile→API→officer→map), Emergency Green Wave, crime-vehicle reads, junction control, hazard AI, plus auth/RBAC/injection security.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "token", "value": "" },
    { "key": "hazardId", "value": "" },
    { "key": "workerToken", "value": "" },
    { "key": "emergencyId", "value": "" },
    { "key": "routeId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Platform health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "1. Hazard workflow (mobile → officer → map)",
      "item": [
        {
          "name": "Login as officer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('login returns a token', () => pm.expect(body.data.token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{officerUsername}}\",\n  \"password\": \"{{officerPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "GET /api/auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('me returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('role is MUNICIPAL_OFFICER', () => pm.expect(pm.response.json().data.role).to.eql('MUNICIPAL_OFFICER'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Report hazard (simulated mobile detection)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('report returns 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('report returns an id', () => pm.expect(body.id).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('hazardId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"latitude\": 6.9271,\n  \"longitude\": 79.8850,\n  \"accelerometerZSpike\": 12.5,\n  \"hazardType\": \"POTHOLE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/hazards/report",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hazards", "report"]
            }
          }
        },
        {
          "name": "Officer pending queue contains the hazard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('pending returns 200', () => pm.response.to.have.status(200));",
                  "const ids = pm.response.json().data.map(h => h.hazardId);",
                  "pm.test('pending contains the new hazard', () => pm.expect(ids).to.include(pm.collectionVariables.get('hazardId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/hazards/pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hazards", "pending"]
            }
          }
        },
        {
          "name": "Officer approves the hazard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('approve returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('hazard is APPROVED', () => pm.expect(pm.response.json().data.approvalStatus).to.eql('APPROVED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/hazards/{{hazardId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hazards", "{{hazardId}}", "approve"]
            }
          }
        },
        {
          "name": "Approved hazard is visible on the public map",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('all returns 200', () => pm.response.to.have.status(200));",
                  "const hazard = pm.response.json().data.find(h => h.hazardId === pm.collectionVariables.get('hazardId'));",
                  "pm.test('approved hazard is visible to the public map', () => {",
                  "  pm.expect(hazard, 'hazard in /all').to.be.an('object');",
                  "  pm.expect(hazard.approvalStatus).to.eql('APPROVED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/hazards/all",
              "host": ["{{baseUrl}}"],
              "path": ["api", "hazards", "all"]
            }
          }
        },
        {
          "name": "Officer workers list (dispatch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('workers returns 200', () => pm.response.to.have.status(200));",
                  "pm.test('workers payload is an array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/workers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workers"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Emergency Green Wave",
      "item": [
        {
          "name": "GET emergency routes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('routes returns 200', () => pm.response.to.have.status(200));",
                  "const routes = pm.response.json();",
                  "pm.test('routes is an array', () => pm.expect(routes).to.be.an('array'));",
                  "if (routes.length > 0) pm.collectionVariables.set('routeId', routes[0].routeId);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/routes", "host": ["{{baseUrl}}"], "path": ["api", "routes"] }
          }
        },
        {
          "name": "Create emergency session (ambulance)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create emergency returns 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('session is ACTIVE', () => pm.expect(body.status).to.eql('ACTIVE'));",
                  "pm.collectionVariables.set('emergencyId', body.sessionId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"11111111-1111-1111-1111-111111111111\",\n  \"vehicleType\": \"Ambulance\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/emergencies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergencies"]
            }
          }
        },
        {
          "name": "Green Wave activation blocked without route/AI approval",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('activation is rejected (400) without route + AI handoff', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/emergencies/{{emergencyId}}/activate-green-wave",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergencies", "{{emergencyId}}", "activate-green-wave"]
            }
          }
        },
        {
          "name": "Cancel emergency session",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('cancel returns 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/emergencies/{{emergencyId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "emergencies", "{{emergencyId}}", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Crime vehicle + junction control + hazard AI",
      "item": [
        {
          "name": "GET crime-vehicle cameras",
          "event": [
