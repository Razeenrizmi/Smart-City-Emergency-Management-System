# ==========================================
# Secrets / Local Configuration
# ==========================================
# appsettings.Development.json holds dev-only values and IS tracked.
# Real secrets belong in user secrets or environment variables.
*.env
.env
.env.*
!.env.example
*.pem
*.key
local.properties

